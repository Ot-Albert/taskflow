# Supabase configuration (optional — app works without these using local storage)
#
# 1. Create a project at https://supabase.com
# 2. Go to Settings → API and copy your Project URL and anon key
# 3. Copy this file to .env and fill in the values
# 4. Run the SQL in supabase/migration.sql in the Supabase SQL editor
#
# The app automatically switches to cloud storage when both are set.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
